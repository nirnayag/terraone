# WordPress REST base. Change when the API moves off terrapha.com.
VITE_WP_BASE=https://terrapha.com/wp-json

# Contact Form 7 form id for the enquiry form (read from the live /contact-us/ form).
VITE_CF7_FORM_ID=5

# reCAPTCHA v3 site key. LEAVE BLANK unless CF7's reCAPTCHA integration is
# also enabled in wp-admin — the two must be switched on together, or every
# submission from this site comes back as spam and never reaches the inbox.
VITE_RECAPTCHA_SITE_KEY=
